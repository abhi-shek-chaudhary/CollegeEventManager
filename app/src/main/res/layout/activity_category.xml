<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Category"
    android:background="@drawable/backgroundd"
    >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="CATEGORY"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:textStyle="bold"
        android:textSize="20sp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="190dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/fashion"
        android:layout_below="@id/title"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/fashion"

            android:id="@+id/fashimage"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fashion Event"
            android:textStyle="bold"
            android:textSize="15dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="50dp"

            />

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/cultural"
        android:layout_toRightOf="@+id/fashion"
        android:layout_below="@+id/title"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/cul"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cultural Event "
            android:textStyle="bold"
            android:textSize="15dp"

            android:layout_gravity="bottom"
            android:layout_marginStart="43dp"

            />



    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="190dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/technical"
        android:layout_below="@+id/fashion"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/technical"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technical Event "
            android:textStyle="bold"
            android:textSize="15dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="43dp"

            />

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/sports"
        android:layout_below="@+id/fashion"
        android:layout_toRightOf="@+id/technical"


        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/sports"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sports Event "
            android:textStyle="bold"
            android:textSize="15dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="43dp"

            />

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="190dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/careerfair"
        android:layout_below="@+id/sports"



        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/careerfair"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="career fair Event "
            android:textStyle="bold"
            android:textSize="15dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="43dp"

            />

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:id="@+id/other"
        android:layout_below="@+id/sports"
        android:layout_toRightOf="@+id/careerfair"





        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/other"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Others "
            android:textStyle="bold"
            android:textSize="15dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="60dp"

            />

    </androidx.cardview.widget.CardView>

</RelativeLayout>